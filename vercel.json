{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/uk-on-wheels run build",
  "framework": null,
  "outputDirectory": "artifacts/uk-on-wheels/dist/public",
  "rewrites": [
    {
      "destination": "/api/weather",
      "source": "/weather-api"
    },
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    }
  ],
  "functions": {
    "api/image-retention.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/image-retention",
      "schedule": "15 3 * * *"
    }
  ]
}
