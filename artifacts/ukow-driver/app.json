{
  "expo": {
    "name": "UK On Wheels Driver",
    "slug": "uk-on-wheels-ltd",
    "owner": "ghulam7913s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ukow-driver",
    "userInterfaceStyle": "light",
    "extra": {
      "portalUrl": "https://portal.ukonwheels.org",
      "eas": {
        "projectId": "e2493dec-778d-4129-9a50-2c6849bc1499"
      }
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Take vehicle inspection and incident evidence photos for UK On Wheels.",
        "NSPhotoLibraryUsageDescription": "Choose vehicle and incident evidence photos to upload to your assigned job.",
        "NSLocationWhenInUseUsageDescription": "Record inspection evidence and share your assigned vehicle location during delivery."
      }
    },
    "android": {
      "package": "org.ukonwheels.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Share your assigned vehicle location with Admin and its Client during delivery, including when the phone is locked. Sharing stops after delivery.",
        "isIosBackgroundLocationEnabled": true,
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }],
      "expo-router",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
